#!/usr/bin/env python3
"""
This node detects if the car succeeded its last action using Euclidean distance between points in two consecutive readings of the accelerometer sensor
"""
import math
import rospy
from std_msgs.msg import Bool, Float64, String
from rosgraph_msgs.msg import Clock 
import time
from geometry_msgs.msg import Pose2D

def mysleep(secs):
    global curr_time

    init_time = curr_time        
    diff = 0.0
    while diff <= secs and not rospy.is_shutdown(): # and not rospy.is_shutdown():
       diff  = curr_time - init_time

def callback_sim_time(msg):
    global curr_time             
    sim_time = msg
    sim_secs = sim_time.clock.secs 
    sim_nsecs = sim_time.clock.nsecs
    curr_time = sim_secs + sim_nsecs / (10**9) 
    
def callback_curr_pos(msg):
    global sdc_curr_pos   

    sdc_curr_pos.x = msg.x
    sdc_curr_pos.y = msg.y
    sdc_curr_pos.theta = msg.theta

def callback_curr_lane(msg):
    global curr_lane
    curr_lane = msg.data    
    
def callback_speed(msg):
    global speed
    speed = msg.data 

def callback_steering(msg):
    global steering
    steering = msg.data  
    
def callback_dist_north(msg):
    global dist_north
    dist_north = msg.data                  
            
def main():
    global latent_collision, curr_time, speed, steering, sdc_curr_pos, car_1_pos, car_2_pos, dist_north, curr_lane    
    
    print("INITIALIZING SPEED CALCULATION...", flush=True)
    rospy.init_node("latent_collision_detector")
    rate = rospy.Rate(10)
        
    sdc_curr_pos = Pose2D()   
    car_1_pos = Pose2D() 
    car_2_pos = Pose2D()    
        
    rospy.Subscriber("/clock", Clock, callback_sim_time)            
                
    rospy.Subscriber("/self_driving_pose", Pose2D, callback_curr_pos)
    rospy.Subscriber("/current_lane", Bool, callback_curr_lane)    
    rospy.Subscriber("/speed", Float64, callback_speed)
    rospy.Subscriber("/steering", Float64, callback_steering)
    rospy.Subscriber("/obstacle/dist_north", Float64, callback_dist_north)
    
    pub_latent_collision  = rospy.Publisher("/latent_collision", Bool, queue_size=1)    
    latent_collision = False
    
    # Extras
    sdc_curr_pos.x = sdc_curr_pos.y = sdc_curr_pos.theta = 0.0    
        
    curr_time = 0.0
    prev_time = 0.0
    speed = 0.0
    estimated_speed_sdc = 0.0    
    estimated_speed_car1 = 0.0
    estimated_speed_car2 = 0.0                
    prev_time = 0.0
    curr_time = 0.0
    delta_t = 0.0
    time_diff = 0.25
    prev_xpos_sdc = 0.0      
    prev_xpos_car1 = 0.0
    prev_xpos_car2 = 0.0 
    dist_north = prev_dist_north = 100000.0
    delta_dist_north = 0.0  
    v_rel = 0.0 
    v_front = 0.0
    dist_threshold = 25 # meters
    time_collision_threshold = 1 # seconds             
    TTC = float('inf')    
                
    while not rospy.is_shutdown():

       delta_dist_north = dist_north - prev_dist_north
       # delta_dist_north != 0.0 'cos the Lidar update cycle is slower
       if delta_dist_north != 0.0:
          prev_dist_north = dist_north
          if dist_north < dist_threshold:                 
             delta_t = curr_time - prev_time
             if delta_t > 0.0:
                estimated_speed_sdc = (sdc_curr_pos.x - prev_xpos_sdc) / delta_t
                v_rel =  estimated_speed_sdc - (delta_dist_north / delta_t)
                TTC = float('inf') 
                if v_rel != 0: 
                   TTC = dist_north / v_rel
                   if TTC < time_collision_threshold:
                      print("WARNING: Car crash ahead! Time to collision=", TTC, "Distance", dist_north, sep = " ", flush = True)
                      latent_collision = True 
                   
          pub_latent_collision.publish(latent_collision)
          prev_xpos_sdc = sdc_curr_pos.x
          prev_time = curr_time
          latent_collision = False       
         
       #mysleep(1)
       rate.sleep()
    

if __name__ == "__main__":
    main()    

