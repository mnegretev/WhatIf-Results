#!/usr/bin/env python3
"""
This node detects if the car succeeded its last action using Euclidean distance between points in two consecutive readings of the accelerometer sensor
"""
import math
import rospy
from std_msgs.msg import Bool, Float64, String
from rosgraph_msgs.msg import Clock 
import time
from geometry_msgs.msg import Pose2D

def mysleep(secs):
    global curr_time

    init_time = curr_time        
    diff = 0.0
    while diff <= secs and not rospy.is_shutdown(): # and not rospy.is_shutdown():
       diff  = curr_time - init_time

def callback_sim_time(msg):
    global curr_time             
    sim_time = msg
    sim_secs = sim_time.clock.secs 
    sim_nsecs = sim_time.clock.nsecs
    curr_time = sim_secs + sim_nsecs / (10**9) 
    
def callback_curr_pos(msg):
    global sdc_curr_pos   

    sdc_curr_pos.x = msg.x
    sdc_curr_pos.y = msg.y
    sdc_curr_pos.theta = msg.theta
    
def callback_speed(msg):
    global speed
    speed = msg.data 

def callback_steering(msg):
    global steering
    steering = msg.data            
            
def callback_car_1_pos(msg):
    global car_1_pos   

    car_1_pos.x = msg.x
    car_1_pos.y = msg.y
    car_1_pos.theta = msg.theta 
       
def callback_car_2_pos(msg):
    global car_2_pos   

    car_2_pos.x = msg.x
    car_2_pos.y = msg.y
    car_2_pos.theta = msg.theta            

def main():
    global curr_time, speed, steering, sdc_curr_pos, car_1_pos, car_2_pos    
    
    print("INITIALIZING SPEED CALCULATION...", flush=True)
    rospy.init_node("latent_collision_detector")
    rate = rospy.Rate(10)
        
    sdc_curr_pos = Pose2D()   
    car_1_pos = Pose2D() 
    car_2_pos = Pose2D()    
        
    rospy.Subscriber("/clock", Clock, callback_sim_time)            
                
    rospy.Subscriber("/self_driving_pose", Pose2D, callback_curr_pos)                 
    rospy.Subscriber("/speed", Float64, callback_speed)  
    rospy.Subscriber("/steering", Float64, callback_steering)
    rospy.Subscriber("/car_1_pose", Pose2D, callback_car_1_pos)
    rospy.Subscriber("/car_2_pose", Pose2D, callback_car_2_pos) 
    
    # Extras
    sdc_curr_pos.x = sdc_curr_pos.y = sdc_curr_pos.theta = 0.0    
    car_1_pos.x = car_1_pos.y = car_1_pos.theta = 0.0     
    car_2_pos.x = car_2_pos.y = car_2_pos.theta = 0.0               
        
    curr_time = 0.0
    prev_time = 0.0
    speed = 0.0
    estimated_speed_sdc = 0.0    
    estimated_speed_car1 = 0.0
    estimated_speed_car2 = 0.0                
    prev_time = 0.0
    curr_time = 0.0
    delta_t = 0.0
    time_diff = 0.25
    prev_xpos_sdc = 0.0      
    prev_xpos_car1 = 0.0
    prev_xpos_car2 = 0.0 
    
    dist_north = prev_dist_north = float('inf')
    delta_dist_north = 0.0    
    TTC = float('inf')    
                
    while not rospy.is_shutdown():
    
       delta_dist_north = dist_north - prev_dist_north
       if delta_dist_north <= 10.0:
          # Patch   
          if curr_lane:
             free_NE = free_N
          else: 
             free_NW = free_N     
       
          delta_t = (curr_time - prev_time)
       if delta_t > time_diff: 
         # m/s
         estimated_speed_sdc = (sdc_curr_pos.x - prev_xpos_sdc) / delta_t
         estimated_speed_car1 = (car_1_pos.x - prev_xpos_car1) / delta_t
         estimated_speed_car2 = -(car_2_pos.x - prev_xpos_car2) / delta_t
              
         delta_t = 0.0 
         
         prev_time = curr_time

       prev_dist_north = dist_north         
       prev_xpos_sdc = sdc_curr_pos.x
       prev_xpos_car1 = car_1_pos.x
       prev_xpos_car2 = car_2_pos.x
         
       #mysleep(1)
       rate.sleep()
    

if __name__ == "__main__":
    main()    

#          string = "curr_time=" + str(curr_time) + " prev_time=" + str(prev_time) + " delta_t=" + str(delta_t) + " requested_speed_sdc=" + str(speed) + " estimated_speed_sdc=" + str(estimated_speed_sdc) + " estimated_speed_car1=" + str(estimated_speed_car1) + " estimated_speed_car2=" + str(estimated_speed_car2) + " sdc_curr_pos.x=" + str(sdc_curr_pos.x) + " car_1_pos.x=" + str(car_1_pos.x) + " car_2_pos.x=" + str(car_2_pos.x)
